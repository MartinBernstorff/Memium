{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Keep requires-python locked at 3.13",
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    }
  ]
}
